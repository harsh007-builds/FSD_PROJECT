									"    console.log('Task ID saved:', res._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Design Database Schema\",\n    \"description\": \"Create the MongoDB schema for the new feature\",\n    \"priority\": \"High\",\n    \"status\": \"Todo\",\n    \"dueDate\": \"2026-10-15\",\n    \"labels\": [\"backend\", \"database\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "tasks"]
						},
						"description": "Create a new task within a project.\n\nStatuses: Backlog, Todo, In Progress, Review, Completed\nPriorities: Low, Medium, High, Urgent"
					},
					"response": []
				}
			]
		},
