							"raw": "{{baseUrl}}/api/projects",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects"]
						},
						"description": "Get all projects the authenticated user owns or is a member of."
					},
					"response": []
				},
				{
					"name": "Create Project",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res._id) {",
									"    pm.collectionVariables.set('projectId', res._id);",
									"    console.log('Project ID saved:', res._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"StudySync Feature Development\",\n    \"description\": \"Building advanced features for the StudySync platform\",\n    \"status\": \"Active\",\n    \"startDate\": \"2026-09-01\",\n    \"deadline\": \"2026-12-31\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/projects",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects"]
						},
						"description": "Create a new project."
					},
					"response": []
				},
				{
					"name": "Get Project by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}"]
						},
						"description": "Get a single project by its ID."
					},
					"response": []
				},
				{
					"name": "Update Project",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"StudySync Feature Development (Updated)\",\n    \"description\": \"Updated description\",\n    \"status\": \"Active\",\n    \"progress\": 25\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}"]
						},
						"description": "Update an existing project."
					},
					"response": []
				},
				{
					"name": "Delete Project",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}"]
						},
						"description": "Delete a project. Only the owner can delete."
					},
					"response": []
				},
				{
					"name": "Add Member to Project",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"member@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/members",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "members"]
						},
						"description": "Add a member to a project by their email."
					},
					"response": []
				},
				{
					"name": "Get Project Workspace",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/workspace",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "workspace"]
						},
						"description": "Get aggregated workspace data for a project including stats, upcoming deadlines, and recent activity."
					},
					"response": []
				}
			]
		},
		{
			"name": "Tasks (Project-Scoped)",
